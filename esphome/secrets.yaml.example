# Kopieren nach secrets.yaml und ausfuellen. secrets.yaml NICHT einchecken.
wifi_ssid: "WomoWLAN"
wifi_password: "..."
fallback_ap_password: "..."
api_encryption_key: "..."   # erzeugen: https://esphome.io/components/api.html#configuration-variables
web_username: "admin"
web_password: "..."
# mqtt_broker: "192.168.8.10"
# WireGuard-Peer (aus der von der Fritzbox erzeugten .conf)
wg_private_key: "..."
wg_peer_public_key: "..."
wg_preshared_key: "..."

# --- BLE-Proxy-ESP (womo-ble-proxy): EIGENER WireGuard-Peer in der Fritzbox anlegen ---
proxy_api_encryption_key: "BASE64-32-BYTE-KEY"
proxy_wg_private_key: "PrivateKey aus [Interface] der zweiten .conf"
proxy_wg_peer_public_key: "PublicKey aus [Peer]"
proxy_wg_preshared_key: "PresharedKey aus [Peer]"
